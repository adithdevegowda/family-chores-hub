{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-chores-hub-private",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-chores-hub-d"
    }
  ]
}
