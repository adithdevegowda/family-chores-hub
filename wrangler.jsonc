{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-chores-hub-private",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-chores-hub-d",
      "database_id": "03efd28f-37ce-496e-8000-9b404aad1711"
    }
  ]
}
